# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=notiflow
POSTGRES_USER=notiflow
POSTGRES_PASSWORD=change_me_strong_password

# ─── Application ──────────────────────────────────────────────────────────────
# Port exposed on the host
APP_PORT=8080

# Must be at least 32 characters; use a random secret in production:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production-at-least-32-bytes-long!!

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:80
